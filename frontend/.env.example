# Frontend environment variables
# Copy this file to frontend/.env and fill in your values.

# Must match HOME_AGENT_API_KEY configured in the backend .env
VITE_API_KEY=your_home_agent_api_key

# Display-only sender labels for the mail confirmation screen.
VITE_GMAIL_ADDRESS=your_email@gmail.com
VITE_UKRNET_ADDRESS=your_email@ukr.net

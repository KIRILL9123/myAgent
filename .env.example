# iCloud CalDAV credentials

# Execution mode — controls side-effect safety
#   real    = разрешены настоящие side effects (отправка почты, календарь, telegram, finance)
#   dry_run = все side-effect функции возвращают {"status":"dry_run","would_do":{...}}
#             вместо реального выполнения. Используется для тестов и CI.
#   Если переменная не задана вообще — по умолчанию dry_run (безопасно по умолчанию).
EXECUTION_MODE=real

CALDAV_URL=https://caldav.icloud.com
CALDAV_USERNAME=your_apple_id@icloud.com
CALDAV_PASSWORD=your_app_specific_password

# Gmail (IMAP/SMTP)
GMAIL_IMAP_HOST=imap.gmail.com
GMAIL_IMAP_PORT=993
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=587
GMAIL_USERNAME=your_email@gmail.com
GMAIL_APP_PASSWORD=your_app_specific_password

# Ukr.net (IMAP/SMTP)
UKRNET_IMAP_HOST=imap.ukr.net
UKRNET_IMAP_PORT=993
UKRNET_SMTP_HOST=smtp.ukr.net
UKRNET_SMTP_PORT=465
UKRNET_USERNAME=your_email@ukr.net
UKRNET_PASSWORD=your_imap_password

# Telegram Notification Bot
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Scheduled Tasks
MORNING_SUMMARY_TIME=08:00

# Subscription Tracker: daily read-only scan of unread IMAP messages
SUBSCRIPTION_EMAIL_SCAN_ENABLED=true
SUBSCRIPTION_EMAIL_SCAN_ACCOUNTS=gmail,ukrnet
SUBSCRIPTION_REMINDER_LEAD_DAYS=7

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:30b-a3b

LLM_MAX_TOKENS=3000

# Model roles (optional, defaults to main model)
# LLM_ROLE_MAIN=Ternary-Bonsai-27B-Q2_0
# LLM_ROLE_EXTRACTOR=qwen2.5:7b
# LLM_ROLE_CLASSIFIER=qwen2.5:7b
# LLM_FALLBACK_MODEL=

# API Key for FastAPI security (Generate a secure token, e.g. python -c "import secrets; print(secrets.token_hex(32))")
HOME_AGENT_API_KEY=changeme-generate-a-real-key

# Read-only public web access
# Optional comma-separated domain allowlist. Empty means public domains only;
# private, loopback and local-network addresses are always blocked.
WEB_ALLOWED_DOMAINS=
WEB_HTTP_TIMEOUT_SECONDS=10
WEB_BROWSER_TIMEOUT_MS=12000
WEB_LIGHTPANDA_CDP_URL=http://127.0.0.1:9222
WEB_SEARCH_REGION=de-de
WEB_DEFAULT_LOCATION=Germany

# Optional: Custom SQLite database path (defaults to backend/home_agent.db if not set)
# DATABASE_PATH=

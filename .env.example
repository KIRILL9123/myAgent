# iCloud CalDAV credentials
CALDAV_URL=https://caldav.icloud.com
CALDAV_USERNAME=your_apple_id@icloud.com
CALDAV_PASSWORD=your_app_specific_password

# Gmail (IMAP/SMTP)
GMAIL_IMAP_HOST=imap.gmail.com
GMAIL_IMAP_PORT=993
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=587
GMAIL_USERNAME=your_email@gmail.com
GMAIL_APP_PASSWORD=your_app_specific_password

# Ukr.net (IMAP/SMTP)
UKRNET_IMAP_HOST=imap.ukr.net
UKRNET_IMAP_PORT=993
UKRNET_SMTP_HOST=smtp.ukr.net
UKRNET_SMTP_PORT=465
UKRNET_USERNAME=your_email@ukr.net
UKRNET_PASSWORD=your_imap_password

# Telegram Notification Bot
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Scheduled Tasks
MORNING_SUMMARY_TIME=08:00

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# API Key for FastAPI security (Generate a secure token, e.g. python -c "import secrets; print(secrets.token_hex(32))")
HOME_AGENT_API_KEY=changeme-generate-a-real-key

# Optional: Custom SQLite database path (defaults to backend/home_agent.db if not set)
# DATABASE_PATH=
